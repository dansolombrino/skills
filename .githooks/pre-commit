#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
# The unit suite stays with scripts/release.sh; this keeps commits fast.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/validate_repo.py"
python3 "$root/scripts/check_version_bump.py" --staged
