[Unit]
Description=ReSirch Killalot: the owner's cross-project list of work (web app on localhost, exposed by tailscale serve)
After=network-online.target

[Service]
Type=simple
Environment=KILLALOT_CONFIG=__KILLALOT_CONFIG__
ExecStart=/usr/bin/env python3 __KILLALOT_PY__ serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
