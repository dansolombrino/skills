[Unit]
Description=ReSirch Killalot TLS proxy (Caddy): https://__DOMAIN__:__PUBLIC_PORT__ -> 127.0.0.1:__APP_PORT__
After=network-online.target

[Service]
Type=simple
EnvironmentFile=__DUCKDNS_ENV__
ExecStart=__CADDY__ run --config __CADDYFILE__ --adapter caddyfile
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
