[Unit]
Description=behemoth-gpu-niceness: samples the shared GPUs and serves the read-only niceness page (loopback, behind service-hub)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 __NICENESS_PY__ serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
